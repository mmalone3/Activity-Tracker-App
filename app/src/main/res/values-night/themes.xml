<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application night theme. -->
    <style name="Theme.ActivityTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#38BDF8</item>
        <item name="colorPrimaryVariant">#0F172A</item>
        <item name="colorOnPrimary">#0F172A</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#34D399</item>
        <item name="colorSecondaryVariant">#059669</item>
        <item name="colorOnSecondary">#0F172A</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#0F172A</item>

        <!-- Custom Action Bar Style -->
        <item name="actionBarStyle">@style/Widget.ActivityTracker.ActionBar</item>
    </style>

    <style name="Widget.ActivityTracker.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">#0F172A</item>
        <item name="titleTextColor">#F8FAFC</item>
        <item name="elevation">1dp</item>
    </style>
</resources>